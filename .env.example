# ================================================================
# Plantilla de variables de entorno (SÍ se sube al repositorio, sin secretos).
#
# Local:  copie este archivo a .env y ajuste los valores, o defina las
#         variables en su terminal / IDE antes de ejecutar la aplicación.
# Render: NO se usa .env. Cree las mismas claves en
#         Dashboard -> servicio -> Environment.
# Spring toma estas variables por encima de application.properties.
# ================================================================

# Puerto HTTP (Render lo define automáticamente)
PORT=8080

# ----------------------------------------------------------------
# Base de datos
#   DB_DRIVER    mysql      -> MySQL / MariaDB (local, docker-compose)
#                postgresql -> PostgreSQL (Supabase)
#   DB_SSL_MODE  vacío en local; "require" para Supabase
#
# Supabase: Project -> Connect -> Direct -> Method "Session pooler"
# (funciona por IPv4, que es lo que soporta Render).
#   DB_HOST=aws-1-<region>.pooler.supabase.com
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USERNAME=postgres.<id-del-proyecto>
# ----------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_SSL_MODE=

# ----------------------------------------------------------------
# Seguridad JWT: al menos 32 bytes aleatorios en Base64.
# Ejemplo para generarlo (PowerShell):
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
# ----------------------------------------------------------------
JWT_SECRET=change_me_base64_32_bytes_or_more
JWT_EXPIRATION_SECONDS=900

# ----------------------------------------------------------------
# Correo (SMTP). El plan gratuito de Render bloquea SMTP: si falla,
# la aplicación sigue funcionando y solo registra una advertencia.
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM_ADDRESS=tu_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios
